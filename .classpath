<?xml version="1.0" encoding="UTF-8"?>
<classpath>
    <!-- Java -->
    <classpathentry kind="con"
        path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17">
        <attributes>
            <attribute name="module" value="true"/>
        </attributes>
    </classpathentry>

    <!-- Source -->
    <classpathentry kind="src" path="src/main/java"/>

    <!-- Web project (Eclipse) -->
    <classpathentry kind="con" path="org.eclipse.jst.j2ee.internal.web.container"/>
    <classpathentry kind="con" path="org.eclipse.jst.j2ee.internal.module.container"/>

    <!-- Librerie locali -->
    <classpathentry kind="lib" path="WebContent/WEB-INF/lib/jdom-2.0.6.jar"/>
    <classpathentry kind="lib" path="WebContent/WEB-INF/lib/log4j-api-2.20.0.jar"/>
    <classpathentry kind="lib" path="WebContent/WEB-INF/lib/log4j-core-2.20.0.jar"/>
    <classpathentry kind="lib" path="WebContent/WEB-INF/lib/mysql-connector-j-8.0.31.jar"/>
    <classpathentry kind="lib" path="WebContent/WEB-INF/lib/jakarta.servlet-api-6.0.0.jar"/>
    <classpathentry kind="lib" path="WebContent/WEB-INF/lib/javax.mail.jar"/>
    <classpathentry kind="lib" path="WebContent/WEB-INF/lib/javax.activation-1.2.0.jar"/>

    <!-- Output -->
    <classpathentry kind="output" path="WebContent/WEB-INF/classes"/>
</classpath>
